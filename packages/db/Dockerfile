# syntax=docker/dockerfile:1
# Build context is the REPO ROOT:
#   docker build -f packages/db/Dockerfile --platform linux/amd64 -t eventide/db-bootstrap .
#
# NOT a compiled binary (unlike the services) — `scripts/bootstrap.ts` shells out
# to `bunx drizzle-kit migrate`, which needs the drizzle-kit CLI, the config
# files and the migration SQL present at runtime. Runs as a one-shot Kubernetes
# Job against RDS: creates the 4 service databases + owner roles, then migrates
# auth_db / event_db / registration_db / payment_db. The auth_db schema is generated by the
# better-auth CLI but applied by drizzle-kit like the others — SYSTEM-DESIGN §4.2.

# --- install only what bootstrap.ts + drizzle-kit need, off the workspace -----
# A focused install (not the monorepo lockfile) keeps this image small — the last
# blob PUT to ECR is what stalls on a VPN (docs/TODO.md §2 Day 4).
FROM oven/bun:1-slim AS deps
WORKDIR /app
RUN bun add \
      postgres@3.4.9 \
      drizzle-orm@0.45.2 \
      drizzle-kit@0.31.10

# --- runtime ----------------------------------------------------------------
FROM oven/bun:1-slim
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json

# Just the db package's runtime surface — schemas, configs, migrations, script.
COPY packages/db/src ./src
COPY packages/db/assets ./assets
COPY packages/db/migrations ./migrations
COPY packages/db/drizzle.auth.config.ts \
     packages/db/drizzle.event.config.ts \
     packages/db/drizzle.registration.config.ts \
     packages/db/drizzle.payment.config.ts ./
COPY packages/db/scripts ./scripts

ENV NODE_ENV=production
# uid 1000 = the `bun` user in oven/bun images. Numeric so k8s runAsNonRoot can
# verify it (a named user fails that check — hit on the first EKS run).
USER 1000
ENTRYPOINT ["bun", "scripts/bootstrap.ts"]
