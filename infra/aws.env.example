# Learner Lab credentials — the ONLY place they go. Copy this file to
# infra/aws.env (gitignored) and paste the three values from
# Learner Lab → AWS Details → "AWS CLI:" (they rotate every session, ~4 h).
# Every Make target and script that touches AWS sources this file; Terraform
# and the AWS CLI read the same variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Optional. With it, a lab reset needs no manual step at all: `make deploy` replaces the 4 NS
# records for the delegated subdomain at Cloudflare by itself (scripts/delegate-dns.sh).
# Without it, `make deploy` prints the 4 names to paste and waits. Create it at Cloudflare ->
# My Profile -> API Tokens -> "Edit zone DNS", restricted to the apex zone (e.g. creasy.club).
# It never leaves this file: it is sent to curl on stdin and never printed.
CLOUDFLARE_API_TOKEN=
