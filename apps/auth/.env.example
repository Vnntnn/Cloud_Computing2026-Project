# apps/auth — local dev overrides. Copy to `.env` (gitignored) only when you need
# to change a default; env.ts already defaults these for `make dev`.
#
# On EKS these come from Secrets Manager `eventide/auth` via External Secrets
# Operator (SYSTEM-DESIGN §5.2) — never commit real values.

DATABASE_URL=postgres://auth_svc:auth_svc@localhost:5432/auth_db
BETTER_AUTH_SECRET=dev-only-insecure-better-auth-secret-0000000
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (SYSTEM-DESIGN §5.1.1). Leave unset for email/password only.
# Redirect URI to register: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
