<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="eventide-v2" name="Eventide V2">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Eventide V2 — one RDS instance, four isolated logical databases" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="auth" value="&lt;b&gt;auth_db&lt;/b&gt;&lt;br&gt;Better Auth: user, account, session, verification, jwks, rate_limit&lt;br&gt;App: login_attempts, user_audit_logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="310" height="180" as="geometry"/></mxCell>
        <mxCell id="event" value="&lt;b&gt;event_db&lt;/b&gt;&lt;br&gt;categories, venues, events&lt;br&gt;ticket_types, event_images&lt;br&gt;event_change_logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="310" height="180" as="geometry"/></mxCell>
        <mxCell id="registration" value="&lt;b&gt;registration_db&lt;/b&gt;&lt;br&gt;ticket_inventory, orders, order_items&lt;br&gt;order_audit_logs, tickets, check_ins&lt;br&gt;idempotency_keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="payment" value="&lt;b&gt;payment_db&lt;/b&gt;&lt;br&gt;payments, payment_attempts, refunds&lt;br&gt;Mock gateway; no card data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="430" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="note" value="Cross-database references are text/UUID identifiers only — never PostgreSQL foreign keys. Internal HTTP uses X-Eventide-Internal-Token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="650" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="auth" target="event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="event" target="registration"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="registration" target="payment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="auth" target="registration"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
