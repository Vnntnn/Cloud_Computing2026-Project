<mxCell id="igw" value="Internet gateway — every outbound call leaves here (nodes have public IPs, no NAT)" style="rounded=1;arcSize=2;whiteSpace=wrap;horizontal=0;html=1;fontSize=11;fontStyle=1;strokeColor=#8C4FFF;fillColor=#F3E5F5;fontColor=#8C4FFF;align=center;verticalAlign=middle;spacingLeft=10;spacingTop=4;spacingBottom=6;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2048" y="440" width="34" height="930" as="geometry"/></mxCell>
