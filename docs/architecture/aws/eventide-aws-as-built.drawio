<mxCell id="dlqbox" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=#E7157B;fillColor=#FCE4EC;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingBottom=6;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2750" y="1010" width="160" height="190" as="geometry"/></mxCell>
